{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true
    },
    "include": ["index.ts", "server.ts", "assets/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
